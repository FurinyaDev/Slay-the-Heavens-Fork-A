+test('Release build UI history rejects a stale or changed #854 owner on reread',async()=>{
+ const {assertIntegrationSuccessorsCurrent,beforeBuildUiEventArt,beforePreflightSource}=await import('./helpers/fork-preflight-source.mjs');
+ const path='scripts/build-ui.mjs',raw=readFileSync(path,'utf8').replaceAll('\r\n','\n');
+ const display=JSON.parse(gunzipSync(readFileSync(new URL('./fixtures/release-reward-display-source.json.gz',import.meta.url))));
+ const previous=beforeBuildUiEventArt(raw);
+ assert.equal(createHash('sha256').update(previous).digest('hex'),display.files[path].after.sha256,'exact #840 successor');
+ const fullPrior=beforePreflightSource(path,raw);
+ assert.notEqual(fullPrior,raw);
+ assert.equal(fullPrior,beforePreflightSource(path,display.files[path].before.source),'existing #840 predecessor chain');
+ for(const eol of ['\n','\r\n']){
+  const input=raw.replaceAll('\n',eol);
+  const reader=(file,encoding)=>file===path?input:readFileSync(file,encoding);
+  assert.doesNotThrow(()=>assertIntegrationSuccessorsCurrent(reader));
+  assert.equal(beforeBuildUiEventArt(input),previous.replaceAll('\n',eol));
+  assert.equal(beforePreflightSource(path,input).replaceAll('\r\n','\n'),fullPrior);
+  const stale=previous.replaceAll('\n',eol);
+  for(const altered of [stale,input+eol,raw.replace('\n','\r\n'),null]){
+   let reads=0;
+   assert.throws(()=>assertIntegrationSuccessorsCurrent((file,encoding)=>{
+    if(file!==path)return readFileSync(file,encoding);
+    if(++reads===1)return input;
+    if(altered===null)throw new Error('missing test owner');
+    return altered;
+   }),/Release UI closeout owner (?:identity|missing): scripts\/build-ui\.mjs/);
+   assert.equal(reads,2,'the first observed current source requires a fresh matching reread');
+  }
+ }
+});
